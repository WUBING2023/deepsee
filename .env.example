# DeepSee loads this file automatically. Never commit real keys.
DEEPSEEK_API_KEY=

# The setup wizard writes these values. The default is a Kimi-compatible API.
OPENDS_BRIDGE_VENDOR=kimi
OPENDS_BRIDGE_API=openai-completions
OPENDS_BRIDGE_BASE_URL=https://api.moonshot.cn/v1
OPENDS_BRIDGE_MODEL=kimi-k3
OPENDS_BRIDGE_API_KEY=

# For a deliberately keyless custom endpoint, use any non-secret placeholder
# such as OPENDS_BRIDGE_API_KEY=local-no-key.

# Product switches. Text-tool delegation is intentionally off by default.
OPENDS_BRIDGE_AUTO_VISION=1
OPENDS_BRIDGE_TEXT_TOOL=0
OPENDS_BRIDGE_MAX_TOKENS=4096
OPENDS_BRIDGE_VISION_CACHE=128

# Optional MinerU installer overrides. Defaults are shown for reproducible customization.
# OPENDS_MINERU_PACKAGE_SPEC=mineru[core]>=3,<4
# OPENDS_MINERU_PYPI_MIRROR=https://mirrors.aliyun.com/pypi/simple
# OPENDS_MINERU_MODEL_SOURCE=auto
# OPENDS_MINERU_SOURCE_ZIP=https://github.com/opendatalab/MinerU/archive/refs/heads/master.zip
# OPENDS_MINERU_SOURCE_EXTRA=core
# OPENDS_MINERU_COMMAND_TIMEOUT_MS=5400000
