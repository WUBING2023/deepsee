# DeepSee never stores provider credentials here. Add API providers in
# DeepSeek Harness Settings > Models; DeepSee reads only Harness route metadata.

# Product switches. Text-tool delegation is intentionally off by default.
OPENDS_BRIDGE_AUTO_VISION=1
OPENDS_BRIDGE_TEXT_TOOL=0
OPENDS_BRIDGE_MAX_TOKENS=4096
OPENDS_BRIDGE_VISION_CACHE=128

# Optional MinerU installer overrides. Defaults are shown for reproducible customization.
# OPENDS_MINERU_PACKAGE_SPEC=mineru[core]>=3,<4
# OPENDS_MINERU_PYPI_MIRROR=https://mirrors.aliyun.com/pypi/simple
# OPENDS_MINERU_MODEL_SOURCE=auto
# OPENDS_MINERU_SOURCE_ZIP=https://github.com/opendatalab/MinerU/archive/refs/heads/master.zip
# OPENDS_MINERU_SOURCE_EXTRA=core
# OPENDS_MINERU_COMMAND_TIMEOUT_MS=5400000

# Optional PaddleOCR/RapidOCR installer overrides. Keep OPENDS_OCR_HOME on an
# ASCII-only path when using PaddleOCR on Windows.
# OPENDS_OCR_HOME=
# OPENDS_OCR_PYPI_MIRROR=https://mirrors.aliyun.com/pypi/simple
# OPENDS_OCR_COMMAND_TIMEOUT_MS=3600000
# PADDLE_PDX_MODEL_SOURCE=BOS

# Optional update-check cache interval. The default is six hours; values below
# one minute are ignored. Updates are installed only after the user clicks Upgrade.
# DEEPSEE_UPDATE_CHECK_INTERVAL_MS=21600000
